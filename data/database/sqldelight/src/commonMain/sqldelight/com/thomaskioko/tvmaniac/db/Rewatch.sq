import com.thomaskioko.tvmaniac.db.EpisodeId;
import com.thomaskioko.tvmaniac.db.Id;
import com.thomaskioko.tvmaniac.db.ShowId;

CREATE TABLE IF NOT EXISTS rewatch_session(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    show_id INTEGER AS Id<ShowId> NOT NULL,
    started_at INTEGER NOT NULL,
    closed_at INTEGER DEFAULT NULL,
    provider_session_id INTEGER DEFAULT NULL,
    FOREIGN KEY(show_id) REFERENCES tvshow(id) ON UPDATE CASCADE ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_rewatch_session_show_id ON rewatch_session(show_id);

CREATE TABLE IF NOT EXISTS rewatch_session_episode(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    session_id INTEGER NOT NULL,
    episode_id INTEGER AS Id<EpisodeId> NOT NULL,
    watched_at INTEGER NOT NULL,
    synced_at INTEGER DEFAULT NULL,
    FOREIGN KEY(session_id) REFERENCES rewatch_session(id) ON DELETE CASCADE,
    FOREIGN KEY(episode_id) REFERENCES episode(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_rewatch_session_episode_session_id ON rewatch_session_episode(session_id);
CREATE INDEX IF NOT EXISTS idx_rewatch_session_episode_episode_id ON rewatch_session_episode(episode_id);

CREATE TABLE IF NOT EXISTS rewatch_restore(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    show_id INTEGER AS Id<ShowId> NOT NULL,
    season_number INTEGER NOT NULL,
    episode_number INTEGER NOT NULL,
    session_id INTEGER NOT NULL,
    watched_at INTEGER NOT NULL,
    ordinal INTEGER NOT NULL,
    FOREIGN KEY(show_id) REFERENCES tvshow(id) ON UPDATE CASCADE ON DELETE CASCADE,
    FOREIGN KEY(session_id) REFERENCES rewatch_session(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_rewatch_restore_show_episode ON rewatch_restore(show_id, season_number, episode_number);

CREATE TRIGGER IF NOT EXISTS restore_rewatches_on_episode_insert
AFTER INSERT ON episode
BEGIN
    INSERT INTO rewatch_session_episode(session_id, episode_id, watched_at, synced_at)
    SELECT rr.session_id, new.id, rr.watched_at, CAST(strftime('%s', 'now') AS INTEGER) * 1000
    FROM rewatch_restore rr
    INNER JOIN season s ON s.id = new.season_id
    WHERE rr.show_id = new.show_id
      AND rr.season_number = s.season_number
      AND rr.episode_number = new.episode_number
      AND rr.ordinal > (
          SELECT COUNT(*)
          FROM rewatch_session_episode
          WHERE episode_id = new.id AND session_id = rr.session_id
      );
END;

openSession:
INSERT INTO rewatch_session(show_id, started_at, closed_at)
VALUES (:showId, :startedAt, NULL);

lastInsertRowId:
SELECT last_insert_rowid();

addEpisodeToSession:
INSERT INTO rewatch_session_episode(session_id, episode_id, watched_at)
VALUES (:sessionId, :episodeId, :watchedAt);

closeSession:
UPDATE rewatch_session
SET closed_at = :closedAt
WHERE id = :sessionId;

sessionsForShow:
SELECT *
FROM rewatch_session
WHERE show_id = :showId
ORDER BY started_at DESC;

openSessionForShow:
SELECT *
FROM rewatch_session
WHERE show_id = :showId AND closed_at IS NULL
ORDER BY started_at DESC
LIMIT 1;

sessionById:
SELECT *
FROM rewatch_session
WHERE id = :sessionId;

setProviderSessionId:
UPDATE rewatch_session
SET provider_session_id = :providerSessionId
WHERE id = :sessionId;

sessionByProviderSessionId:
SELECT *
FROM rewatch_session
WHERE show_id = :showId AND provider_session_id = :providerSessionId;

insertProviderSession:
INSERT INTO rewatch_session(show_id, started_at, closed_at, provider_session_id)
VALUES (:showId, :startedAt, :closedAt, :providerSessionId);

mergeProviderSession:
UPDATE rewatch_session
SET started_at = MIN(started_at, :startedAt),
    closed_at = COALESCE(:closedAt, closed_at)
WHERE id = :sessionId;

sessionCoverage:
SELECT
    (SELECT COUNT(DISTINCT rse.episode_id)
     FROM rewatch_session_episode rse
     INNER JOIN episode e ON rse.episode_id = e.id
     INNER JOIN season s ON e.season_id = s.id
     WHERE rse.session_id = rs.id
       AND (s.season_number > 0 OR s.title != 'Specials')
       AND (e.first_aired IS NULL OR e.first_aired <= :nowMillis)) AS watched_in_session,
    (SELECT COUNT(*)
     FROM episode e
     INNER JOIN season s ON e.season_id = s.id
     WHERE e.show_id = rs.show_id
       AND (s.season_number > 0 OR s.title != 'Specials')
       AND (e.first_aired IS NULL OR e.first_aired <= :nowMillis)) AS aired_total
FROM rewatch_session rs
WHERE rs.id = :sessionId;

observeEpisodeRewatches:
SELECT COUNT(*) AS rewatch_count
FROM rewatch_session_episode
WHERE episode_id = :episodeId;

removeEpisodeRewatches:
DELETE FROM rewatch_session_episode
WHERE episode_id = :episodeId;

removeEpisodeRestores:
DELETE FROM rewatch_restore
WHERE EXISTS (
    SELECT 1
    FROM episode
    INNER JOIN season ON season.id = episode.season_id
    WHERE episode.id = :episodeId
      AND episode.show_id = rewatch_restore.show_id
      AND season.season_number = rewatch_restore.season_number
      AND episode.episode_number = rewatch_restore.episode_number
);

removeSeasonRewatches:
DELETE FROM rewatch_session_episode
WHERE episode_id IN (
    SELECT episode.id
    FROM episode
    INNER JOIN season ON season.id = episode.season_id
    WHERE season.show_id = :showId AND season.season_number = :seasonNumber
);

removeSeasonRestores:
DELETE FROM rewatch_restore
WHERE show_id = :showId AND season_number = :seasonNumber;

clearRestoresForShow:
DELETE FROM rewatch_restore
WHERE show_id = :showId;

restoredShowIds:
SELECT DISTINCT show_id
FROM rewatch_restore;

insertRestore:
INSERT INTO rewatch_restore(show_id, season_number, episode_number, session_id, watched_at, ordinal)
VALUES (:showId, :seasonNumber, :episodeNumber, :sessionId, :watchedAt, :ordinal);

restoreMissingViewings:
WITH missing AS (
    SELECT
        rr.id AS restore_id,
        rr.session_id,
        rr.watched_at,
        e.id AS episode_id,
        EXISTS (
            SELECT 1
            FROM rewatch_session_episode stored
            WHERE stored.episode_id = e.id
              AND stored.watched_at = rr.watched_at
              AND NOT EXISTS (
                  SELECT 1
                  FROM rewatch_restore reported
                  WHERE reported.show_id = rr.show_id
                    AND reported.season_number = rr.season_number
                    AND reported.episode_number = rr.episode_number
                    AND reported.session_id = stored.session_id
              )
        ) AS has_stored_match,
        (
            SELECT COUNT(*)
            FROM rewatch_restore reported
            WHERE reported.show_id = rr.show_id
              AND reported.season_number = rr.season_number
              AND reported.episode_number = rr.episode_number
        ) - (SELECT COUNT(*) FROM rewatch_session_episode WHERE episode_id = e.id) AS viewings_to_write
    FROM rewatch_restore rr
    INNER JOIN season s ON s.show_id = rr.show_id AND s.season_number = rr.season_number
    INNER JOIN episode e ON e.season_id = s.id AND e.episode_number = rr.episode_number
    WHERE rr.show_id = :showId
      AND rr.ordinal > (
          SELECT COUNT(*)
          FROM rewatch_session_episode
          WHERE episode_id = e.id AND session_id = rr.session_id
      )
)
INSERT INTO rewatch_session_episode(session_id, episode_id, watched_at, synced_at)
SELECT m.session_id, m.episode_id, m.watched_at, :syncedAt
FROM missing m
WHERE (
    SELECT COUNT(*)
    FROM missing other
    WHERE other.episode_id = m.episode_id
      AND (
          other.has_stored_match < m.has_stored_match
          OR (other.has_stored_match = m.has_stored_match AND other.restore_id <= m.restore_id)
      )
) <= m.viewings_to_write;

rewatchTotals:
SELECT
    COUNT(*) AS viewings,
    CAST(COALESCE(SUM(COALESCE(episode.runtime, tvshow.runtime)), 0) AS INTEGER) AS minutes
FROM rewatch_session_episode
INNER JOIN rewatch_session ON rewatch_session.id = rewatch_session_episode.session_id
INNER JOIN tvshow ON tvshow.id = rewatch_session.show_id
LEFT JOIN episode ON episode.id = rewatch_session_episode.episode_id;

unsentEpisodes:
SELECT
    rse.id AS row_id,
    rse.session_id,
    rs.show_id,
    season.season_number,
    episode.episode_number,
    rse.watched_at
FROM rewatch_session_episode rse
INNER JOIN rewatch_session rs ON rse.session_id = rs.id
INNER JOIN episode ON rse.episode_id = episode.id
INNER JOIN season ON episode.season_id = season.id
WHERE rse.synced_at IS NULL
ORDER BY rse.id ASC;

countUnsentEpisodes:
SELECT COUNT(*)
FROM rewatch_session_episode
WHERE synced_at IS NULL;

markEpisodeSynced:
UPDATE rewatch_session_episode
SET synced_at = :syncedAt
WHERE id = :rowId;

rewatchStatusForShow:
SELECT
    (SELECT COUNT(*)
     FROM rewatch_session
     WHERE show_id = :showId AND closed_at IS NOT NULL) AS finished_count,
    open_session.id AS open_session_id,
    (SELECT COUNT(DISTINCT rse.episode_id)
     FROM rewatch_session_episode rse
     INNER JOIN episode e ON rse.episode_id = e.id
     INNER JOIN season s ON e.season_id = s.id
     WHERE rse.session_id = open_session.id
       AND (s.season_number > 0 OR s.title != 'Specials')
       AND (e.first_aired IS NULL OR e.first_aired <= :nowMillis)) AS watched_in_session,
    (SELECT COUNT(*)
     FROM episode e
     INNER JOIN season s ON e.season_id = s.id
     WHERE e.show_id = :showId
       AND (s.season_number > 0 OR s.title != 'Specials')
       AND (e.first_aired IS NULL OR e.first_aired <= :nowMillis)) AS aired_total
FROM tvshow
LEFT JOIN rewatch_session AS open_session
    ON open_session.show_id = tvshow.id AND open_session.closed_at IS NULL
WHERE tvshow.id = :showId
ORDER BY open_session.started_at DESC
LIMIT 1;

clearAllRestores:
DELETE FROM rewatch_restore;

clearAllSessionEpisodes:
DELETE FROM rewatch_session_episode;

clearAllSessions:
DELETE FROM rewatch_session;
