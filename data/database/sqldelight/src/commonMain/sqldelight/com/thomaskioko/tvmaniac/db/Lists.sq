CREATE TABLE IF NOT EXISTS lists(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    trakt_id INTEGER,
    slug TEXT,
    name TEXT NOT NULL,
    description TEXT,
    item_count INTEGER NOT NULL DEFAULT 0,
    created_at TEXT NOT NULL,
    pending_action TEXT NOT NULL DEFAULT 'NOTHING'
        CHECK(pending_action IN ('NOTHING', 'UPLOAD', 'DELETE'))
);

CREATE UNIQUE INDEX IF NOT EXISTS index_lists_trakt_id ON lists (trakt_id);

selectAll:
SELECT id, trakt_id, slug, name, description, item_count, created_at
FROM lists
ORDER BY name ASC;

selectTraktIdById:
SELECT trakt_id
FROM lists
WHERE id = :id;

selectAllWithPosters:
SELECT
    lists.id,
    lists.trakt_id,
    lists.slug,
    lists.name,
    lists.description,
    lists.item_count,
    lists.created_at,
    show.poster_path AS poster_url
FROM lists
LEFT JOIN list_shows ON list_shows.list_id = lists.id
    AND list_shows.pending_action != 'DELETE'
    AND EXISTS (
        SELECT 1 FROM tvshow s
        WHERE s.tmdb_id = list_shows.tmdb_id AND s.poster_path IS NOT NULL
    )
    AND (
        SELECT COUNT(*)
        FROM list_shows newerShows
        JOIN tvshow ns ON ns.tmdb_id = newerShows.tmdb_id AND ns.poster_path IS NOT NULL
        WHERE newerShows.list_id = list_shows.list_id
            AND newerShows.pending_action != 'DELETE'
            AND (
                newerShows.listed_at > list_shows.listed_at
                OR (newerShows.listed_at = list_shows.listed_at AND newerShows.tmdb_id > list_shows.tmdb_id)
            )
    ) < 4
LEFT JOIN tvshow show ON show.tmdb_id = list_shows.tmdb_id
ORDER BY lists.name ASC, list_shows.listed_at DESC, list_shows.tmdb_id DESC;

upsertByTraktId:
INSERT INTO lists(trakt_id, slug, name, description, item_count, created_at)
VALUES(?, ?, ?, ?, ?, ?)
ON CONFLICT(trakt_id) DO UPDATE SET
    slug = excluded.slug,
    name = excluded.name,
    description = excluded.description,
    item_count = excluded.item_count;

selectSyncedIds:
SELECT id, trakt_id
FROM lists
WHERE trakt_id IS NOT NULL;

deleteById:
DELETE FROM lists WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();

deleteAll:
DELETE FROM lists;
